<mujoco model="z1_hammer_robot">
  <!-- Standalone Z1 arm + rigidly-attached hammer for mjlab EntityCfg loading.
       No mocap body, no weld equality, no scene elements (floor/nail/block).
       DifferentialIKActionCfg targets hammer_head_site for 3-DoF position control. -->
  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="z1">
      <joint damping="1" frictionloss="1"/>
      <general biastype="affine" gainprm="1000" biasprm="0 -1000 -100" forcerange="-30 30"/>
      <default class="z1_visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="z1_collision">
        <geom type="cylinder" group="3" mass="0" density="0"/>
        <default class="z1_gripper_stator_collision">
          <geom pos="0.051 0 0" type="mesh"/>
        </default>
        <default class="z1_gripper_stator_pad_collision_1">
          <geom type="box" size="0.014 0.015 0.004" pos="0.186 -0.015 -0.0125" friction="1.5 0.02 0.002"/>
        </default>
        <default class="z1_gripper_stator_pad_collision_2">
          <geom type="box" size="0.014 0.015 0.004" pos="0.186 0.015 -0.0125" friction="1.5 0.02 0.002"/>
        </default>
        <default class="z1_gripper_mover_collision">
          <geom type="mesh"/>
        </default>
        <default class="z1_gripper_mover_pad_collision_1">
          <geom type="box" size="0.014 0.015 0.004" pos="0.086 -0.015 -0.0055" friction="1.5 0.02 0.002"/>
        </default>
        <default class="z1_gripper_mover_pad_collision_2">
          <geom type="box" size="0.014 0.015 0.004" pos="0.086 0.015 -0.0055" friction="1.5 0.02 0.002"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <mesh file="z1_Link00.stl"/>
    <mesh file="z1_Link01.stl"/>
    <mesh file="z1_Link02.stl"/>
    <mesh file="z1_Link03.stl"/>
    <mesh file="z1_Link04.stl"/>
    <mesh file="z1_Link05.stl"/>
    <mesh file="z1_Link06.stl"/>
    <mesh file="z1_GripperStator.stl"/>
    <mesh file="z1_GripperStator_col_1.stl"/>
    <mesh file="z1_GripperStator_col_2.stl"/>
    <mesh file="z1_GripperStator_col_3.stl"/>
    <mesh file="z1_GripperStator_col_4.stl"/>
    <mesh file="z1_GripperStator_col_5.stl"/>
    <mesh file="z1_GripperStator_col_6.stl"/>
    <mesh file="z1_GripperMover.stl"/>
    <mesh file="z1_GripperMover_col_1.stl"/>
    <mesh file="z1_GripperMover_col_2.stl"/>
    <mesh file="z1_GripperMover_col_3.stl"/>
    <mesh file="z1_GripperMover_col_4.stl"/>
    <mesh file="z1_GripperMover_col_5.stl"/>
    <!-- Real claw hammer (SimToolReal, MIT, (c) Tyler Lum). Visual + 5-piece
         convex collision decomposition. See meshes/claw_hammer/ATTRIBUTION.txt. -->
    <mesh name="claw_hammer_vis" file="claw_hammer/claw_hammer.obj"/>
    <mesh name="claw_hammer_c0" file="claw_hammer/decomp_0.obj"/>
    <mesh name="claw_hammer_c1" file="claw_hammer/decomp_1.obj"/>
    <mesh name="claw_hammer_c2" file="claw_hammer/decomp_2.obj"/>
    <mesh name="claw_hammer_c3" file="claw_hammer/decomp_3.obj"/>
    <mesh name="claw_hammer_c4" file="claw_hammer/decomp_4.obj"/>
  </asset>

  <worldbody>
    <body name="link00" childclass="z1">
      <inertial pos="-0.00334984 -0.00013615 0.0249584" quat="-0.00692194 0.682592 0.00133293 0.730766"
                mass="0.472475"
                diaginertia="0.000531375 0.000415207 0.000378658"/>
      <geom class="z1_visual" mesh="z1_Link00"/>
      <geom size="0.0325 0.0255" pos="0 0 0.0255" class="z1_collision"/>
      <body name="link01" pos="0 0 0.0585">
        <inertial pos="2.47e-06 -0.00025198 0.0231717" quat="0.708578 0.705633 0.000281462 -0.000355927"
                  mass="0.673326"
                  diaginertia="0.00128328 0.000839362 0.000719308"/>
        <joint name="joint1" axis="0 0 1" range="-2.61799 2.61799"/>
        <geom class="z1_visual" mesh="z1_Link01"/>
        <body name="link02" pos="0 0 0.045">
          <inertial pos="-0.110126 0.00240029 0.00158266" quat="0.00748058 0.707092 -0.0114473 0.70699"
                    mass="1.19132"
                    diaginertia="0.0246612 0.0243113 0.00100468"/>
          <joint name="joint2" axis="0 1 0" range="0 2.96706" damping="2"/>
          <geom class="z1_visual" mesh="z1_Link02"/>
          <geom size="0.0325 0.051" quat="1 1 0 0" class="z1_collision"/>
          <geom size="0.0225 0.1175" pos="-0.1625 0 0" quat="1 0 1 0" class="z1_collision"/>
          <geom size="0.0325 0.0255" pos="-0.35 0 0" quat="1 1 0 0" class="z1_collision"/>
          <body name="link03" pos="-0.35 0 0">
            <inertial pos="0.106092 -0.00541815 0.0347638" quat="0.540557 0.443575 0.426319 0.573839"
                      mass="0.839409"
                      diaginertia="0.00954365 0.00938711 0.000558432"/>
            <joint name="joint3" axis="0 1 0" range="-2.87979 0"/>
            <geom class="z1_visual" mesh="z1_Link03"/>
            <geom size="0.02 0.058" pos="0.128 0 0.055" quat="1 0 1 0" class="z1_collision"/>
            <geom size="0.0325 0.0295" pos="0.2205 0 0.055" quat="0.5 -0.5 0.5 0.5" class="z1_collision"/>
            <body name="link04" pos="0.218 0 0.057">
              <inertial pos="0.0436668 0.00364738 -0.00170192" quat="0.0390835 0.726445 -0.0526787 0.684087"
                        mass="0.564046" diaginertia="0.000981656 0.00094053 0.000302655"/>
              <joint name="joint4" axis="0 1 0" range="-1.51844 1.51844"/>
              <geom class="z1_visual" mesh="z1_Link04"/>
              <geom size="0.0325 0.0335" pos="0.072 0 0" class="z1_collision"/>
              <body name="link05" pos="0.07 0 0">
                <inertial pos="0.0312153 0 0.00646316" quat="0.462205 0.535209 0.53785 0.45895"
                          mass="0.389385"
                          diaginertia="0.000558961 0.000547317 0.000167332"/>
                <joint name="joint5" axis="0 0 1" range="-1.3439 1.3439"/>
                <geom class="z1_visual" mesh="z1_Link05"/>
                <body name="link06" pos="0.0492 0 0">
                  <inertial pos="0.0241569 -0.00017355 -0.00143876" quat="0.998779 0.0457735 -0.00663717 0.0173548"
                            mass="0.288758"
                            diaginertia="0.00018333 0.000147464 0.000146786"/>
                  <joint name="joint6" axis="1 0 0" range="-2.79253 2.79253"/>
                  <geom class="z1_visual" mesh="z1_Link06"/>
                  <geom size="0.0325 0.0255" pos="0.0255 0 0" quat="1 0 1 0" class="z1_collision"/>
                  <geom pos="0.051 0 0" type="mesh" mesh="z1_GripperStator" class="z1_visual"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_1"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_2"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_3"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_4"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_5"/>
                  <geom class="z1_gripper_stator_collision" mesh="z1_GripperStator_col_6"/>
                  <geom class="z1_gripper_stator_pad_collision_1"/>
                  <geom class="z1_gripper_stator_pad_collision_2"/>

                  <body name="ee_center_body" pos="0.15 0 0">
                    <site name="ee_center_site" size="0.01" group="3"/>

                    <body name="hammer" pos="-0.015 0.0 -0.01">
                      <!-- Real claw hammer (SimToolReal mesh, MIT) replacing the box+capsule.
                           GRASP #10 (chosen 2026-06-16 from the 24-orientation sweep,
                           scripts/diag_sweep_all.py + diag_inspect.py): every hammer geom uses quat
                           "0.70710678 0 0 0.70710678", which lays the handle out along the gripper axis
                           and points the flat striking FACE straight DOWN at the nail, forked claw UP.
                           GRIP POSITION (user pick 2026-06-16, scripts/diag_grip_choice.py): geoms slid
                           to pos "0 0.006 0" (80 mm along -body-Y from 0 0.086 0) so the gripper clamps
                           the handle 80 mm closer to the head; head<->gripper clearance stays 72 mm.
                           COLLISION: faithful SimToolReal 5-piece CoACD decomposition (decomp_0..4),
                           each a separate convex geom (claw notch stays open). KEY FACT (verified
                           2026-06-16): MuJoCo already COMPENSATES each mesh's principal-axis reframe in
                           the compiled geom_pos/quat, so every piece uses the SAME pos/quat as the visual
                           and auto-aligns at ANY shared quat (collision-union vs visual hull AABB =
                           0.98 mm at this grasp; scripts/diag_collision_check.py). The old per-piece
                           pos+quat scheme (compute_hammer_mount.py) double-applied the reframe and was
                           WRONG. PIECE IDENTITY (verified visually, diag_inspect.py): the striking FACE
                           is c4 (the rounded poll), the forked CLAW is c1+c2, the neck is c3, shaft is c0
                           -- the OPPOSITE of the earlier note that called c1+c2 the face. The contact
                           sensor (pattern hammer_head_.*) must count the FACE, so the head namespace is:
                             hammer_head_0 = c4 (FACE)   hammer_head_1 = c3 (neck)   -> COUNTED as a strike
                             hammer_claw_0/1 = c1/c2 (claw)  hammer_handle_col = c0 (shaft) -> EXCLUDED.
                           At the near-nail reset the FACE LEADS by 56 mm: face 42 mm from the nail vs
                           claw 98 mm (diag_collision_check.py), so the face contacts first, not the claw.
                           hammer_head_site (0.0326,0.132,-0.0004) is the c4 FACE centroid = DiffIK frame
                           + head obs + SingleStrikeReference target, so IK drives the real striking face
                           onto the nail. (Earlier no-contact bug: the site sat ~12 cm off the mesh on the
                           old box-head point; fixed here.) Mass 0.5 kg (~0.4 head + 0.1 handle). -->
                      <inertial pos="0 0.1 0" mass="0.5" diaginertia="0.0012 0.0004 0.0012"/>
                      <geom name="hammer_visual" type="mesh" mesh="claw_hammer_vis"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" contype="0" conaffinity="0"
                            group="2" mass="0" rgba="0.45 0.45 0.48 1"/>
                      <geom name="hammer_head_0" type="mesh" mesh="claw_hammer_c4"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" mass="0" friction="1.5 0.02 0.002" group="3"/>
                      <geom name="hammer_head_1" type="mesh" mesh="claw_hammer_c3"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" mass="0" friction="1.5 0.02 0.002" group="3"/>
                      <geom name="hammer_claw_0" type="mesh" mesh="claw_hammer_c1"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" mass="0" friction="1.5 0.02 0.002" group="3"/>
                      <geom name="hammer_claw_1" type="mesh" mesh="claw_hammer_c2"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" mass="0" friction="1.5 0.02 0.002" group="3"/>
                      <geom name="hammer_handle_col" type="mesh" mesh="claw_hammer_c0"
                            pos="0 0.006 0" quat="0.70710678 0 0 0.70710678" mass="0" friction="1.5 0.02 0.002" group="3"/>
                      <site name="hammer_head_site" pos="0.0326 0.132 -0.0004" size="0.01" rgba="0 1 0 1"/>
                      <site name="hammer_handle_site" pos="0 0 0" size="0.01" rgba="0 0 1 1"/>
                    </body>
                  </body>

                  <body name="gripperMover" pos="0.1 0 0">
                    <inertial pos="0.0132063 0.00476708 0.00380534"
                              quat="0.0631093 0.669067 -0.0615783 0.737953"
                              mass="0.276213"
                              diaginertia="0.000359044 0.000270888 0.000172378"/>
                    <joint name="jointGripper" axis="0 1 0" range="-1.51844 0"/>
                    <geom type="mesh" mesh="z1_GripperMover" class="z1_visual"/>
                    <geom class="z1_gripper_mover_collision" mesh="z1_GripperMover_col_1"/>
                    <geom class="z1_gripper_mover_collision" mesh="z1_GripperMover_col_2"/>
                    <geom class="z1_gripper_mover_collision" mesh="z1_GripperMover_col_3"/>
                    <geom class="z1_gripper_mover_collision" mesh="z1_GripperMover_col_4"/>
                    <geom class="z1_gripper_mover_collision" mesh="z1_GripperMover_col_5"/>
                    <geom class="z1_gripper_mover_pad_collision_1"/>
                    <geom class="z1_gripper_mover_pad_collision_2"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Self-collision hygiene (audit D1, 2026-06-16): the hammer is rigidly mounted
       into the link06 wrist subtree and sits right beside the vestigial gripperMover,
       so any hammer<->arm/gripper contact is a spurious narrowphase candidate, never a
       real collision. Excluding the pairs stops the solver from wasting work on / ever
       emitting a phantom contact between the hammer and the limb carrying it. Exclude
       only removes contacts, so it cannot change the strike dynamics. -->
  <contact>
    <exclude body1="hammer" body2="gripperMover"/>
    <exclude body1="hammer" body2="link06"/>
  </contact>

</mujoco>
