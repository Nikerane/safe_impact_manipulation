<mujoco model="nail_block_scene">
  <!-- Standalone wooden block + sliding nail for mjlab EntityCfg / spec_fn loading.
       Positions are in world frame assuming the robot base is at the origin.
       The nail slides downward (axis 0 0 -1); goal is nail_slide qpos = 0.075 (fully driven). -->
  <compiler angle="radian" autolimits="true"/>

  <worldbody>
    <!-- Wooden block fixed to the world -->
    <body name="block" pos="0.50 0 0.40">
      <geom name="block_geom"
            type="box"
            size="0.125 0.09 0.03"
            rgba="0.65 0.22 0.08 1"
            friction="1.5 0.01 0.001"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Nail — slides downward into block -->
    <body name="nail" pos="0.50 0 0.46">
      <joint name="nail_slide"
             type="slide"
             axis="0 0 -1"
             range="0 0.075"
             damping="1"
             frictionloss="10.0"/>
      <geom name="nail_shaft" type="cylinder" pos="0 0 -0.035" size="0.003 0.04"
            mass="0.005" rgba="0.55 0.55 0.55 1"
            contype="0" conaffinity="0"/>
      <geom name="nail_head"  type="cylinder" pos="0 0 0.006"  size="0.012 0.004"
            mass="0.002" rgba="0.45 0.45 0.45 1"
            solref="0.008 1" solimp="0.9 0.95 0.001 0.5 2"/>
      <site name="nail_top" pos="0 0 0.012" size="0.008" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>
